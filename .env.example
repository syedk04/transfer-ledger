# Copy this file to `.env` at the repo root (uvicorn backend.main:app loads
# it on startup via python-dotenv).

# Free at console.groq.com - sign up, create an API key. Used by the
# not-yet-built agent loop (backend/agent/loop.py, a later commit).
GROQ_API_KEY=

# Free at newsdata.io - sign up, the API key is on your dashboard. Free tier:
# 200 credits/day, 10 articles/request, /latest endpoint only (news from the
# last 48 hours - no historical date-range search). Used by
# backend/agent/tools/news.py's search_news tool.
NEWSDATA_API_KEY=
